# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-this-to-a-long-random-string
# The public address of the site, with no trailing slash. Used for the sitemap, robots.txt and Open Graph links.
SITE_URL=https://tauplo.example.lt
# The port the app listens on, on the host machine. Put a reverse proxy (Caddy, nginx) with HTTPS in front of it.
PORT=3000
